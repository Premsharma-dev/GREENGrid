# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database Configuration (MySQL / PostgreSQL / SQLite)
DB_NAME="greengrid_db"
DB_USER="greengrid_user"
DB_PASSWORD="greengrid_password"
DB_HOST="localhost"
DB_PORT="3306"

# Security & Authentication
SECRET_KEY="django-insecure-greengrid-secret-key-production-grade"
JWT_SECRET="greengrid-jwt-production-secret-token-key-2026"
DEBUG="True"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173"

# Frontend API Configuration
VITE_API_URL="/api"

